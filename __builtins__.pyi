# Game API functions
"""Initialize the system and run diagnostics."""
def boot() -> None: ...
"""Turn on the power grid."""
def activate_power() -> None: ...
"""Bring the sensor array online. Requires power."""
def activate_sensors() -> None: ...
"""Look up an infrastructure pipe by id. Returns a `Pipe` object, or `None` if no pipe by that id exists."""
def get_pipe(pipe_id: str) -> Pipe: ...
"""List every infrastructure pipe currently laid (complete or in-progress)."""
def list_pipes() -> list[Pipe]: ...
"""Output text to the console. Multiple values are joined by `sep` (default a single space). `end` is appended after the last value (default a newline — empty string suppresses the line break, useful for progress prefixes that overwrite themselves)."""
def print(*values: Any, sep: str = ..., end: str = ...) -> None: ...
"""Output an amber warning line to the persistent console. Same argument behavior as `print()`, but routed to the WARNINGS filter. Use it for background monitors that need attention without showing a toast. Use `notify(text, "warn")` when the player should be interrupted."""
def warn(*values: Any, sep: str = ..., end: str = ...) -> None: ...
"""Output low-priority telemetry to the persistent console. Same argument behavior as `print()`, but hidden from the ALL view unless debug output is enabled in console options. Use it for noisy tuning data that should not crowd normal logs."""
def debug(*values: Any, sep: str = ..., end: str = ...) -> None: ...
"""Clear the console output."""
def clear() -> None: ...
"""Show a toast to the player and add it to the **Computer → Notifications** archive. Use sparingly — for events that genuinely need the operator's attention (battery critical, contract solved, drone stranded). Prefer `print()` for ongoing telemetry. `level` is one of `"info"` (default), `"warn"`, or `"error"` and drives the toast's color + the history entry's severity badge. `duration_seconds` overrides the default toast lifetime (5s info/warn, 6s error); clamped to **0.5s-30s** so a script can't pin a permanent toast. Distinct notifications fire back-to-back (queued by the toast manager); identical consecutive notifications from the same script collapse inside a 1-second window so a tight loop can't spam the screen."""
def notify(text: str, level: str = ..., duration_seconds: float = ...) -> None: ...
"""Intentionally wait before continuing. Loops are paced automatically; sleep is for deliberate game-time delays."""
def sleep(seconds: float) -> None: ...
"""Length of a list, tuple, string, dict, or set."""
def len(value: Any) -> float: ...
"""List of integers from `start` to `stop` (exclusive), stepping by `step`. `range(5)` → `[0,1,2,3,4]`. All arguments must be integers — passing a float raises an error. `step` of `0` is rejected. Negative `step` counts down: `range(5, 0, -1)` → `[5,4,3,2,1]`."""
def range(stop: float) -> list[float]: ...
"""Convert to string."""
def str(value: Any) -> str: ...
"""Convert to integer. From a number: truncates toward zero (`int(3.7)` → 3, `int(-3.7)` → -3). From a string: the **whole trimmed string must be a valid integer literal** (optional sign + digits) — `int("12abc")` raises. Two-arg form parses a string in the given base 2..36: `int("ff", 16)` → 255, `int("101", 2)` → 5. `0x` / `0b` / `0o` prefixes are accepted when the base matches."""
def int(value: Any, base: Any = ...) -> float: ...
"""Convert to float. From a string: the **whole trimmed string must be a valid float literal** (sign, digits, decimal point, exponent, or `inf` / `nan` — case-insensitive). `float("1.5xyz")` raises. Booleans coerce to `0.0` / `1.0`."""
def float(value: Any) -> float: ...
