    """The grid height in cells (32)."""
    def height(self) -> float: ...
    """A guaranteed-clear foothold cell, returned as `[x, y]`. Probe it first to get a reading and begin the deduction."""
    def start(self) -> list[Any]: ...
    """Probe a cell. A clear cell returns its **reading** — how many of its 8 surrounding cells hold a volatile node (`0`-`8`). A cell that holds a node **trips the lattice**: it returns `-1`, and every probe after a trip also returns `-1`. An out-of-bounds coordinate returns `-1`. Only ever probe cells you have *proven* clear."""
    def probe(self, x: float, y: float) -> float: ...

