class Panel:
    """panel (panel scripts only)"""
    """Bordered subsection with optional title bar. Use to group related content visually — mirrors the dashboard's card aesthetic. Returns `None`.

`preview
card(8, 8, 264, 64, "Section")
`"""
    def card(self, x: float, y: float, w: float, h: float, title: str = ...) -> None: ...
    """Horizontal or vertical separator line in the muted border color. Use to break a panel into visual zones. Returns `None`.

`preview
divider(10, 40, 270, 40)
`"""
    def divider(self, x1: float, y1: float, x2: float, y2: float) -> None: ...
    """Semantically styled text. `style` accepts `"title"` (bright, bold), `"caption"` (muted, uppercase), `"muted"` (secondary), `"value"` (numeric readout). Defaults to `"title"`. Use instead of `draw_text` when you want the dashboard's text hierarchy applied automatically. Returns `None`.

`preview
label(10, 30, "OXYGEN", "caption")
`"""
    def label(self, x: float, y: float, text: str, style: str = ...) -> None: ...
    """Colored disc resolved from a status string. Recognized values: `"running"` (green), `"paused"` (warning), `"error"` (error red), `"idle"` (muted). Renders with a subtle outer glow ring. Useful for per-row indicators in machine lists. Returns `None`.

`preview
status_dot(0, 0, 5, "running")
`"""
    def status_dot(self, x: float, y: float, r: float, status: str) -> None: ...
    """Green/grey power-toggle pill matching the dashboard's machine on/off control. Pure visual indicator — panels can't trigger toggles (no `self`). Returns `None`.

`preview
toggle(10, 12, true, "powered")
`"""
    def toggle(self, x: float, y: float, on: bool, label: str = ...) -> None: ...
    """Rounded badge with text — achievement-style. Color accepts theme tokens (`"accent"`, `"success"`, `"warning"`, `"error"`, `"text-muted"`) or hex. Use for status labels or category tags. Returns `None`.

`preview
pill(10, 22, "earned", "success")
`"""
    def pill(self, x: float, y: float, text: str, color: str = ...) -> None: ...
    """Big-number stat block — large value on top, small uppercase label below. Use for headline numbers (credits, day count, ingot inventory). `size` defaults to **24**. Returns `None`.

`preview
counter(16, 38, 87, "shipped", 26)
`"""
    def counter(self, x: float, y: float, value: Any, label: str = ..., size: float = ...) -> None: ...
    """Horizontal fill bar with track + filled accent. `fraction` clamps to **0..1**. Color defaults to `"accent"`; use `"success"`, `"warning"`, `"error"` for traffic-light cues. Returns `None`.

`preview
progress_bar(0.72, "success")
`"""
    def progress_bar(self, x: float, y: float, w: float, h: float, fraction: float, color: str = ...) -> None: ...
    """Vertical fill bar, fills from the bottom up. Same `fraction` and color rules as `progress_bar`. Use when the panel layout favors verticality (multi-tank stacks, atmospheric stacks). Returns `None`.

`preview
vertical_bar(110, 10, 30, 60, 0.6)
`"""
    def vertical_bar(self, x: float, y: float, w: float, h: float, fraction: float, color: str = ...) -> None: ...
    """Multi-bar comparison chart, themed alternating colors, optional labels under each bar. `max` is optional — omit to auto-scale to the largest value. Returns `None`.

`preview
bar_chart(0, 0, 0, 0, [42, 80, 26, 61, 95], 100)
`"""
    def bar_chart(self, x: float, y: float, w: float, h: float, values: Any, max: float = ..., labels: Any = ...) -> None: ...
    """Semicircle dial with arc fill. `fraction` clamps to **0..1**, sweeping from bottom-left around to bottom-right. Optional center label sits in the middle (typically the value as text). Returns `None`.

`preview
gauge(140, 50, 32, 0.62, "62%")
`"""
    def gauge(self, x: float, y: float, radius: float, fraction: float, label: str = ...) -> None: ...
    """Compact trend line drawn from a numeric series. Player accumulates values into a list and pushes the most recent on each tick — the widget normalizes to the series' min/max range and fills a subtle area below the line. Empty / single-value series no-op. Returns `None`.

`preview
spark_line(0, 0, 0, 0)
`"""
    def spark_line(self, x: float, y: float, w: float, h: float, values: Any) -> None: ...
    """Text rendered in monospace at the given size. Optional `wrap` (pixel width) enables greedy word-wrapping into a multi-line block — useful for log feeds and order briefings. Color accepts theme tokens or hex. Returns `None`.

`preview
draw_text(10, 24, "Hello, panel.", 14, "text-bright")
`"""
    def draw_text(self, x: float, y: float, text: str, size: float = ..., color: str = ..., wrap: float = ...) -> None: ...
    """Render any item icon from `itemIcons.ts` at the requested size. Item id is the same string you'd pass to `inventory` / `storage_bin` APIs (`"iron_ore"`, `"iron_ingot"`, `"water"`, etc.). Unknown ids no-op silently. Returns `None`.

`preview
draw_icon()
`"""
    def draw_icon(self, x: float, y: float, item_id: str, size: float = ...) -> None: ...
    """Outlined rectangle in the given color (defaults to `"border"`). Use for custom subsection borders or visual frames. Returns `None`.

`preview
draw_rect(10, 10, 260, 60, "accent")
`"""
    def draw_rect(self, x: float, y: float, w: float, h: float, color: str = ...) -> None: ...
    """Filled rectangle in the given color (defaults to `"accent"`). Use for backgrounds, progress fills, color blocks. Returns `None`.

`preview
fill_rect(10, 10, 260, 60, "success")
`"""
    def fill_rect(self, x: float, y: float, w: float, h: float, color: str = ...) -> None: ...
    """Outlined circle in the given color. Returns `None`.

`preview
draw_circle(140, 40, 24, "accent")
`"""
    def draw_circle(self, x: float, y: float, r: float, color: str = ...) -> None: ...
    """Filled disc in the given color. Returns `None`.

`preview
fill_circle(140, 40, 24, "warning")
`"""
    def fill_circle(self, x: float, y: float, r: float, color: str = ...) -> None: ...
    """Single straight line. Returns `None`.

`preview
draw_line(10, 40, 270, 40, "accent")
`"""
    def draw_line(self, x1: float, y1: float, x2: float, y2: float, color: str = ...) -> None: ...
    """Wipe the panel canvas. Call at the top of every `while True:` loop iteration so old paint doesn't ghost behind new paint. Returns `None`."""
    def clear(self) -> None: ...
    """Reserved for a future stateful-pen API. In v1 every widget takes its own `color` parameter, so this is a no-op kept in the surface for forward compatibility. Returns `None`."""
