class CoreDevice:
    """.device"""
    """Submit a rebuilt core for slot `index` (0-9); `bytes` is a list of integers 0-255. Returns "locked" when the core is well-formed and every surviving byte is unchanged — that slot is now recovered. Returns "rejected" if it breaks a construction rule or changes a surviving byte, or "invalid" for a slot index outside 0-9. A rejected slot can be retried freely."""
    def submit(self, index: float, bytes: Any) -> str: ...
    """How many of the 10 cores have been recovered so far."""
    def recovered(self) -> float: ...
    """The number of cores you must recover to complete the contract — 10."""
    def target(self) -> float: ...
    """The passcode to transmit — a non-empty string once recovered() reaches target(), otherwise an empty string."""
    def token(self) -> str: ...

